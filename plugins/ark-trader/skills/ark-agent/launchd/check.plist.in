<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- 範本：由 schedule.py（install.sh schedule）代入 @…@ 佔位符後寫到
     ~/Library/LaunchAgents/，不要直接複製本檔。 -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>@LABEL@</string>

  <!-- 隨選的前置檢查，沒有排程時段。用途是在**真正的 launchd 環境**下驗證
       輔助使用權限與券商連線——AX 權限按執行檔授權，Terminal 有不代表
       launchd job 有。載入時跑一次；改動排程或系統升級後重跑：

         launchctl kickstart -k gui/$(id -u)/@LABEL@
  -->
  <key>ProgramArguments</key>
  <array>
    <!-- 進入點必須是 uv 而非 /bin/bash：macOS 封鎖系統二進位檔在 launchd 下
         存取 ~/Documents 等受保護目錄（防止用腳本繞過 TCC），實測 /bin/bash
         連讀取 daily.py 都會 Operation not permitted。 -->
    <string>@UV@</string>
    <string>run</string>
    <string>@DAILY@</string>
    <string>check</string>
  </array>

  <key>RunAtLoad</key>
  <true/>

  <key>WorkingDirectory</key>
  <string>@WORKDIR@</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>@PATH@</string>
    <key>HOME</key>
    <string>@HOME@</string>
    <key>ARK_BACKEND</key>
    <string>@BACKEND@</string>
    <!-- ~/.ark-toolkit/agent.env 的個人化設定（ARK_RULES、ARK_DECISION_MODEL…）於產生時代入 -->
@EXTRA_ENV@  </dict>

  <key>StandardOutPath</key>
  <string>@LOG_DIR@/launchd.check.out</string>
  <key>StandardErrorPath</key>
  <string>@LOG_DIR@/launchd.check.err</string>
</dict>
</plist>
