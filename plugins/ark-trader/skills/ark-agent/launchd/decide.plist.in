<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- 範本：由 schedule.py（install.sh schedule）代入 @…@ 佔位符後寫到
     ~/Library/LaunchAgents/，不要直接複製本檔。 -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>@LABEL@</string>

  <key>ProgramArguments</key>
  <array>
    <!-- 進入點必須是 uv 而非 /bin/bash：macOS 封鎖系統二進位檔在 launchd 下
         存取 ~/Documents 等受保護目錄（防止用腳本繞過 TCC），實測 /bin/bash
         連讀取 daily.py 都會 Operation not permitted。 -->
    <string>@UV@</string>
    <string>run</string>
    <string>@DAILY@</string>
    <string>decide</string>
  </array>

  <!-- 平日 10:00：此時 ARK 已用當日盤中資料重算過至少一次（官方：指標約每小時
       重算、台股盤中算出調台股），同時避開 09:00–09:30 的開盤波動。 -->
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Weekday</key><integer>1</integer><key>Hour</key><integer>10</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Weekday</key><integer>2</integer><key>Hour</key><integer>10</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Weekday</key><integer>3</integer><key>Hour</key><integer>10</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Weekday</key><integer>4</integer><key>Hour</key><integer>10</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Weekday</key><integer>5</integer><key>Hour</key><integer>10</integer><key>Minute</key><integer>0</integer></dict>
  </array>

  <!-- launchd 對錯過的排程會在喚醒後補跑一次，這裡擋不掉——時間窗改由
       daily.py 的 in_window() 守：decide ±60 分、settle ±240 分，逾時直接放棄。 -->

  <key>WorkingDirectory</key>
  <string>@WORKDIR@</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>@PATH@</string>
    <key>HOME</key>
    <string>@HOME@</string>
    <!-- 送單後端：預設 simulation；只有 install.sh schedule 帶 live 旗標才會是 live -->
    <key>ARK_BACKEND</key>
    <string>@BACKEND@</string>
    <!-- ~/.ark-toolkit/agent.env 的個人化設定（ARK_RULES、ARK_DECISION_MODEL…）於產生時代入 -->
@EXTRA_ENV@  </dict>

  <key>StandardOutPath</key>
  <string>@LOG_DIR@/launchd.decide.out</string>
  <key>StandardErrorPath</key>
  <string>@LOG_DIR@/launchd.decide.err</string>
</dict>
</plist>
