<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- 範本：由 schedule.py（install.sh schedule）代入 @…@ 佔位符後寫到
     ~/Library/LaunchAgents/，不要直接複製本檔。 -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>@LABEL@</string>

  <key>ProgramArguments</key>
  <array>
    <!-- 進入點必須是 uv 而非 /bin/bash：macOS 封鎖系統二進位檔在 launchd 下
         存取 ~/Documents 等受保護目錄（防止用腳本繞過 TCC），實測 /bin/bash
         連讀取 daily.py 都會 Operation not permitted。 -->
    <string>@UV@</string>
    <string>run</string>
    <string>@DAILY@</string>
    <string>settle</string>
  </array>

  <!-- 平日 14:30：收盤（13:30）後一小時，成交與交割數字都已定案。 -->
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Weekday</key><integer>1</integer><key>Hour</key><integer>14</integer><key>Minute</key><integer>30</integer></dict>
    <dict><key>Weekday</key><integer>2</integer><key>Hour</key><integer>14</integer><key>Minute</key><integer>30</integer></dict>
    <dict><key>Weekday</key><integer>3</integer><key>Hour</key><integer>14</integer><key>Minute</key><integer>30</integer></dict>
    <dict><key>Weekday</key><integer>4</integer><key>Hour</key><integer>14</integer><key>Minute</key><integer>30</integer></dict>
    <dict><key>Weekday</key><integer>5</integer><key>Hour</key><integer>14</integer><key>Minute</key><integer>30</integer></dict>
  </array>

  <!-- 結算的時間窗比 decide 寬（±240 分）：那是對既成事實的記錄，晚幾小時
       做結果一樣，漏做卻會讓熔斷基準斷掉。窗寬定義在 daily.py 的 WINDOWS。 -->

  <key>WorkingDirectory</key>
  <string>@WORKDIR@</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>@PATH@</string>
    <key>HOME</key>
    <string>@HOME@</string>
    <key>ARK_BACKEND</key>
    <string>@BACKEND@</string>
    <!-- ~/.ark-toolkit/agent.env 的個人化設定（ARK_RULES、ARK_DECISION_MODEL…）於產生時代入 -->
@EXTRA_ENV@  </dict>

  <key>StandardOutPath</key>
  <string>@LOG_DIR@/launchd.settle.out</string>
  <key>StandardErrorPath</key>
  <string>@LOG_DIR@/launchd.settle.err</string>
</dict>
</plist>
